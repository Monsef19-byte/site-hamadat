# Copiez ce fichier en .env (local) ou déclarez ces variables dans
# Vercel → Project Settings → Environment Variables (production).

# Mot de passe du dashboard admin (choisissez un mot de passe fort).
ADMIN_PASSWORD=change-me

# Clé secrète utilisée pour signer le cookie de session admin (chaîne aléatoire longue).
JWT_SECRET=change-me-too-a-long-random-string

# Token GitHub (Personal Access Token, scope "repo") utilisé par le dashboard
# pour committer les modifications de contenu (data/*.json) dans le dépôt.
# Chaque sauvegarde admin = un commit Git = un redeploy Vercel automatique.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Dépôt GitHub cible, au format "owner/repo".
GITHUB_REPO=votre-compte/hamadat-website

# Branche à committer (généralement "main").
GITHUB_BRANCH=main

# Token Vercel Blob (Storage → Blob → créer un store → copier le token en lecture/écriture).
# Utilisé pour l'upload des images (résidences, logo) depuis le dashboard admin.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Mettre à "local" pour forcer l'adaptateur de stockage local (dev), sinon
# la détection est automatique (présence de GITHUB_TOKEN / VERCEL env).
# STORAGE_ADAPTER=local
