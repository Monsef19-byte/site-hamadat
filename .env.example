# Copiez ce fichier en .env et remplissez les valeurs avant `npm run dev`.
# En production, ces variables se configurent dans Vercel → Project Settings
# → Environment Variables — jamais dans le dépôt Git.

# --- Dashboard admin ---
ADMIN_PASSWORD=
JWT_SECRET=

# --- Écriture du contenu (data/*.json) en production ---
GITHUB_TOKEN=
GITHUB_REPO=votre-compte/votre-repo
GITHUB_BRANCH=main

# --- Upload d'images en production ---
BLOB_READ_WRITE_TOKEN=

# --- Notification e-mail des demandes du formulaire de contact ---
# Tout le reste (destinataire, serveur SMTP, port, expéditeur) se configure
# depuis le dashboard admin → « Réglages Email ». Seul le mot de passe reste
# ici, jamais versionné avec le contenu. Pour un compte Gmail, utilisez un
# « mot de passe d'application » (myaccount.google.com/apppasswords), pas le
# mot de passe normal du compte.
SMTP_PASSWORD=
